{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scarlet",
  "version": "0.1.0",
  "identifier": "app.scarlet.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": { "maps-dark/*.webp": "dark/" },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
